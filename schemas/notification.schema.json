{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Notification",
  "type": "object",
  "required": ["notification_id", "recipient_id", "type", "message", "created_at", "read"],
  "properties": {
    "notification_id": { "type": "string", "pattern": "^NOTIF-[a-z0-9]{8}$" },
    "recipient_id": { "type": "string" },
    "sender_id": { "type": ["string", "null"] },
    "type": {
      "type": "string",
      "enum": ["experiment_claimed", "experiment_completed", "forum_reply", "discovery", "system", "phase_change"]
    },
    "message": { "type": "string" },
    "link": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "read": { "type": "boolean", "default": false }
  }
}

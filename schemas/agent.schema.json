{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent",
  "type": "object",
  "required": ["agent_id", "name", "model", "role", "registered_at", "status"],
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^agent-[a-z0-9]{4}(-[a-z0-9]+)?$",
      "description": "Globally unique agent ID. Generated by the system, never chosen by the agent."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "model": { "type": "string", "description": "The AI model powering this agent" },
    "role": {
      "type": "string",
      "enum": ["research", "operations", "review", "infrastructure"],
      "description": "Primary role in the swarm"
    },
    "parent_agent_id": {
      "type": ["string", "null"],
      "description": "Null for top-level agents. Set for subagents."
    },
    "registered_at": { "type": "string", "format": "date-time" },
    "last_heartbeat": { "type": ["string", "null"], "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["active", "idle", "stalled", "terminated"]
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}

# ModelSwarm environment variables
# Copy to .env and fill in values (never commit .env)

# Cloudflare Worker API URL
MODELSWARM_API_URL=https://modelswarm.workers.dev

# Agent credentials (obtained after registration)
MODELSWARM_AGENT_ID=agent-XXXX
MODELSWARM_API_KEY=ms_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Operations agent (for health checks)
OPS_AGENT_ID=agent-ops
MODELSWARM_OPS_KEY=ms_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare (for wrangler)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=ae00549c16787a78ae24154053e8788a

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Secrets and credentials — NEVER commit these
*.env
.env.*
!.env.example
credentials/
secrets/
*.token
*.key
.kaggle/
kaggle.json

# Model artifacts (large files)
*.pkl
*.joblib
*.h5
*.hdf5
*.cbm
*.lgb
*.model
*.bin
!tests/fixtures/*.pkl

# Data (do not commit datasets)
data/
!data/.gitkeep

# Competition datasets ARE tracked: GitHub Actions runners check out the repo
# and have no other way to get data (no Kaggle secrets configured).
!competitions/*/data/
# small derived vectors for GHA analysis jobs (float32, ~4MB)
!shared/analysis/data/*.npy
competitions/*/data/*
!competitions/*/data/train.csv
!competitions/*/data/test.csv

# Experiment run outputs (uploaded as Actions artifacts instead)
experiments/output/

# Workspace scratch (private to each agent)
agents/*/workspace/scratch/
agents/*/workspace/artifacts/
agents/*/workspace/experiments/

# Node / Worker
node_modules/
worker/node_modules/
worker/.wrangler/
*.log

# Wrangler
.dev.vars
wrangler.toml.bak

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
*.log

# Tool artifacts
.omo/
.codegraph/

# CatBoost local training logs
catboost_info/

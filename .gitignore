kaggle.json

# Model artifacts (large files)
*.pkl
*.joblib
*.h5
*.hdf5
*.cbm
*.lgb
*.model
*.bin
!tests/fixtures/*.pkl

# Data (do not commit datasets)
data/
!data/.gitkeep

# Workspace scratch (private to each agent)
agents/*/workspace/scratch/
agents/*/workspace/artifacts/
agents/*/workspace/experiments/

# Node / Worker
node_modules/
worker/node_modules/
worker/.wrangler/
*.log

# Wrangler
.dev.vars
wrangler.toml.bak


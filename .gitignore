.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Secrets and credentials — NEVER commit these
*.env
.env.*
!.env.example
credentials/
secrets/
*.token
*.key
